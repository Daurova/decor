FROM node:20-alpine AS base

# Устанавливаем turbo глобально
RUN npm install -g turbo
WORKDIR /app

# --- ЭТАП PRUNE ---
# Копируем весь репозиторий и вырезаем только то, что нужно для api
FROM base AS pruner
COPY . .
RUN turbo prune api --docker

# --- ЭТАП УСТАНОВКИ ЗАВИСИМОСТЕЙ ---
FROM base AS installer
# Копируем только package.json и lock-файл из вырезанной части
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
# Ставим зависимости только для api
RUN npm ci

# --- ЭТАП СБОРКИ ---
FROM installer AS builder
# Копируем исходники из вырезанной части
COPY --from=pruner /app/out/full/ .
# Собираем только пакет api (и его зависимости)
RUN npx turbo run build --filter=api...

# --- ФИНАЛЬНЫЙ ЭТАП ---
FROM base AS runner
WORKDIR /app
# Копируем собранный dist и зависимости
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./package.json

EXPOSE 4000
CMD ["node", "dist/main"]